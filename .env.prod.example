# Production values for PetHost. Put them in the project's /.env on PetHost. Never commit real values.

SECRET_KEY=generate-a-long-random-value
ALLOWED_HOSTS=auction-store.example.pethost.app
CSRF_TRUSTED_ORIGINS=https://auction-store.example.pethost.app
# Use a hard-to-guess admin path, for example "manage-7f3k2/".
ADMIN_URL=manage-change-me/
STORE_NAME=Auction Store

# Database (the db service). Use a long random password.
POSTGRES_DB=auction_store
POSTGRES_USER=auction_store
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgres://auction_store:generate-a-long-random-password@db:5432/auction_store

# New order emails to the owner (optional). Example for Gmail with an app password:
# EMAIL_URL=smtp+tls://you%40gmail.com:app-password@smtp.gmail.com:587
EMAIL_URL=consolemail://
ORDER_ALERT_EMAIL=
DEFAULT_FROM_EMAIL=store@example.com

# Turn on after the site works on HTTPS (31536000 = 1 year).
SECURE_HSTS_SECONDS=0
