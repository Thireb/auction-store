# Copy this file to .env and change the values. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (the db service in compose.yaml)
POSTGRES_DB=auction_store
POSTGRES_USER=auction_store
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://auction_store:change-me@db:5432/auction_store

# Where uploaded images are stored (the media volume in Docker)
MEDIA_ROOT=/data/media

# Admin URL path (do not use the default "admin/" in production)
ADMIN_URL=admin/

# Email for new order alerts to the owner (optional, any SMTP account)
EMAIL_URL=consolemail://
ORDER_ALERT_EMAIL=
DEFAULT_FROM_EMAIL=store@example.com
